---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonCard from '../components/PersonCard.astro';
import { getPeople } from '../lib/people';
import { href } from '../lib/paths';

const team = (await getPeople()).filter((p) => p.data.team).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="About" current="about">
  <div class="container">
    <section class="title-block">
      <div class="text">
        <span class="label">About</span>
        <h1 class="h1">The Open Lab model, brought online.</h1>
        <p class="lede">
          Open Lab Online is an international, community-driven initiative. It builds on the experience of the Nencki Open Lab and the
          wider Open Lab network.
        </p>
      </div>
      <figure class="fig">
        <svg viewBox="0 0 96 96" role="img" aria-label="Illustration: three overlapping circles above one pulse signal">
          <circle cx="28" cy="34" r="18" fill="#A0CFE6" style="mix-blend-mode:multiply"></circle>
          <circle cx="48" cy="34" r="18" fill="#00A5A3" style="mix-blend-mode:multiply"></circle>
          <circle cx="68" cy="34" r="18" fill="#9A4061" style="mix-blend-mode:multiply"></circle>
          <path d="M4 82 H24 V68 H72 V82 H92" fill="none" stroke="#1C1E1F" stroke-width="1.6"></path>
          <line x1="24" y1="56" x2="24" y2="92" stroke="#1C1E1F" stroke-width="0.8" stroke-dasharray="1.5 2"></line>
        </svg>
        <figcaption>Fig. — Warsaw, Cambridge, Heidelberg, and now online.</figcaption>
      </figure>
    </section>

    <div class="two-col body">
      <div class="main-col">
        <section class="stack">
          <h2 class="h2">What we do</h2>
          <div class="reading">
            <p>
              We run hands-on workshops, seminars and courses on open-source tools for neuroscience. Topics run from designing behavioural
              experiments and setups, through experimental control and synchronisation, to data analysis, visualisation and presentation.
            </p>
            <p>Every session is free and online, so researchers anywhere can take part.</p>
          </div>
        </section>
        <section class="stack">
          <h2 class="h2">Where we come from</h2>
          <p class="reading">
            The Nencki Open Lab is an international network launched by neuroscientists from the Nencki Institute in Warsaw. It now runs in
            Warsaw, Cambridge and Heidelberg. Its School of Tools has taught electronics, Python and Bonsai, data analysis and microscopy in
            more than 30 workshops and two summer schools, with a focus on students from under-resourced countries and institutions.
          </p>
        </section>
        <figure class="quote">
          <blockquote>
            <span aria-hidden="true">“</span>Extend the Open Lab spirit internationally through accessible online training and the exchange
            of expertise across labs and countries.”
          </blockquote>
          <figcaption>Our goal, from the launch announcement, February 2026</figcaption>
        </figure>
        {
          team.length > 0 && (
            <section class="stack">
              <h2 id="team" class="h2">
                The team
              </h2>
              <div class="grid">
                {team.map((p) => (
                  <PersonCard person={p} />
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="side-col" aria-labelledby="short-heading">
        <div class="side-card">
          <h2 id="short-heading" class="short-title">In short</h2>
          <dl>
            <div><dt>Formats</dt><dd>Workshops, seminars and courses</dd></div>
            <div><dt>Cost</dt><dd>Free</dd></div>
            <div><dt>Where</dt><dd>Online, on Google Meet or Discord</dd></div>
            <div><dt>Language</dt><dd>English</dd></div>
          </dl>
          <div class="more">
            <a class="link-strong" href={href('/people/')}>Meet the tutors →</a>
            <a class="link-strong" href={href('/archive/')}>Past sessions →</a>
          </div>
        </div>
      </aside>
    </div>

    <section class="cta-line">
      <p>Want to teach, or help shape what we teach?</p>
      <a class="btn btn-outline" href={href('/get-involved/')}>Get involved <span aria-hidden="true">→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .title-block {
    padding-top: 40px;
  }
  .body {
    border-top: 1px solid var(--rule);
    padding: 56px 0 64px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .quote {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .quote blockquote {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    line-height: 1.5;
  }
  .quote blockquote span {
    font-style: normal;
    font-weight: 900;
    color: var(--plum);
  }
  .quote figcaption {
    font-size: 14px;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 12px;
  }
  .short-title {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  dl > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
  }
  dt {
    font-size: 14px;
    color: var(--muted);
  }
  dd {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.45;
  }
  .more {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
    padding-top: 8px;
  }
  #team {
    scroll-margin-top: 24px;
  }
</style>
