---
import site from '../data/site.json';
import { href, linkOr } from '../lib/paths';
const contact = site.contact_email ? `mailto:${site.contact_email}` : '#';
---

<footer class="site-footer container">
  <nav aria-label="Footer" class="links">
    <a href={href('/get-involved/')}>Propose a session</a>
    <a href={linkOr(site.newsletter_url)}>Newsletter</a>
    <a href={href('/code-of-conduct/')}>Code of conduct</a>
    <a href={href('/privacy/')}>Privacy</a>
    <a href={contact}>Contact</a>
  </nav>
  <div class="colophon">
    <span class="network">
      Part of the <a href={site.nencki_url}>Open Labs network</a>, started at the Nencki Institute, Warsaw.
    </span>
    <span class="credit">Set in Merriweather · Designed and built by <strong>Marin Dauguet</strong></span>
  </div>
</footer>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    align-items: center;
    border-top: 1px solid var(--rule);
    padding: 16px 0 8px;
    font-size: 14px;
    font-weight: 500;
  }
  .links a {
    padding: 12px 0;
  }
  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 40px;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--rule);
    padding: 16px 0 36px;
    color: var(--muted);
  }
  .network {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 14px;
  }
  .network a {
    color: inherit;
  }
  .credit {
    font-size: 13px;
  }
  .credit strong {
    color: var(--ink);
  }
</style>
