---
import site from '../data/site.json';
const SIGNAL = 'M6 146 H80 V98 H120 V146 H300 V72 H330 V146 H440';
const SIGNAL_STRIP = 'M20 62 H60 V34 H90 V62 H276 V26 H300 V62 H360';
---

<section class="banner-wrap">
  <div class="banner">
    <div class="art" aria-hidden="true">
      <svg class="wide" viewBox="0 0 440 280" preserveAspectRatio="xMaxYMin meet">
        <defs><clipPath id="signal-wide"><circle cx="372" cy="26" r="100"></circle></clipPath></defs>
        <rect x="80" y="36" width="40" height="244" fill="#A0CFE6"></rect>
        <circle cx="372" cy="26" r="100" fill="#9A4061"></circle>
        <line x1="80" y1="14" x2="80" y2="280" stroke="#1C1E1F" stroke-width="1" stroke-dasharray="2 4"></line>
        <rect x="2" y="142" width="8" height="8" fill="#1C1E1F"></rect>
        <path d={SIGNAL} fill="none" stroke="#1C1E1F" stroke-width="2.2"></path>
        <path d={SIGNAL} fill="none" stroke="#EEEFEC" stroke-width="2.2" clip-path="url(#signal-wide)"></path>
      </svg>
      <svg class="strip" viewBox="0 0 360 84" preserveAspectRatio="xMaxYMin meet">
        <defs><clipPath id="signal-strip"><circle cx="330" cy="4" r="64"></circle></clipPath></defs>
        <rect x="60" y="20" width="30" height="64" fill="#A0CFE6"></rect>
        <circle cx="330" cy="4" r="64" fill="#9A4061"></circle>
        <line x1="60" y1="8" x2="60" y2="84" stroke="#1C1E1F" stroke-width="1" stroke-dasharray="2 4"></line>
        <rect x="16" y="58" width="8" height="8" fill="#1C1E1F"></rect>
        <path d={SIGNAL_STRIP} fill="none" stroke="#1C1E1F" stroke-width="2"></path>
        <path d={SIGNAL_STRIP} fill="none" stroke="#EEEFEC" stroke-width="2" clip-path="url(#signal-strip)"></path>
      </svg>
    </div>
    <div class="text">
      <h1>{site.tagline}</h1>
      <p>Online workshops and talks you can join from any lab, in any time zone.</p>
    </div>
  </div>
</section>

<style>
  .banner-wrap {
    max-width: 1264px;
    margin: 0 auto;
    padding: 4px var(--gutter) 0;
  }
  .banner {
    position: relative;
    background: var(--stone);
    border-radius: var(--r-card);
    overflow: hidden;
    container-type: inline-size;
  }
  .art {
    position: absolute;
    top: 0;
    right: 0;
    width: 36%;
    height: 100%;
  }
  .art svg {
    width: 100%;
    height: 100%;
  }
  .strip {
    display: none;
  }
  .text {
    position: relative;
    max-width: min(680px, 64%);
    padding: clamp(32px, 3.4vw, 44px) clamp(20px, 4vw, 48px) clamp(88px, 8vw, 108px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.22;
  }
  p {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.6;
    color: var(--stone-sub);
  }
  @container (max-width: 720px) {
    .art {
      position: relative;
      width: 100%;
      height: 84px;
    }
    .wide {
      display: none;
    }
    .strip {
      display: block;
    }
    .text {
      max-width: none;
      padding-top: 4px;
    }
  }

  /* Phones: the banner runs edge to edge and the copy tightens. */
  @media (max-width: 640px) {
    .banner-wrap {
      padding: 0;
    }
    .banner {
      border-radius: 0;
    }
    .text {
      gap: 8px;
      padding: 0 var(--gutter) 60px;
    }
    h1 {
      font-size: 1.5rem;
      line-height: 1.22;
    }
    p {
      font-size: 0.95rem;
      line-height: 1.5;
    }
  }
</style>
