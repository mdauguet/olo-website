---
/**
 * One geometric figure per topic, in the retro-scientific "Fig." style.
 * Two or three flat shapes plus a line; colours from the brand palette.
 */
import type { TopicId } from '../data/topics';

interface Props {
  topic?: TopicId;
  class?: string;
}
const { topic = 'synchronization', class: className } = Astro.props;

const FIGS: Record<TopicId, { caption: string; alt: string; svg: string }> = {
  synchronization: {
    caption: 'Two devices, one clock edge.',
    alt: 'Two pulse signals with their rising edges aligned on one clock line',
    svg: `<rect x="26" y="8" width="20" height="82" fill="#A0CFE6" style="mix-blend-mode:multiply"/>
      <circle cx="70" cy="30" r="16" fill="#00A5A3" style="mix-blend-mode:multiply"/>
      <path d="M4 42 H26 V16 H46 V42 H66 V16 H86 V42 H92" fill="none" stroke="#1C1E1F" stroke-width="1.6"/>
      <path d="M4 82 H26 V58 H56 V82 H92" fill="none" stroke="#9A4061" stroke-width="1.6"/>
      <line x1="26" y1="4" x2="26" y2="92" stroke="#1C1E1F" stroke-width="0.8" stroke-dasharray="1.5 2"/>`,
  },
  'closed-loop': {
    caption: 'Output, fed back as input.',
    alt: 'A square and a circle joined by a closed loop with an arrow',
    svg: `<rect x="10" y="18" width="38" height="38" fill="#A0CFE6"/>
      <circle cx="64" cy="54" r="22" fill="#00A5A3" style="mix-blend-mode:multiply"/>
      <path d="M24 38 H80 V84 H16 V46" fill="none" stroke="#1C1E1F" stroke-width="1.6"/>
      <path d="M11 51 L16 45 L21 51" fill="none" stroke="#1C1E1F" stroke-width="1.6"/>
      <rect x="12" y="78" width="8" height="8" fill="#9A4061"/>`,
  },
  imaging: {
    caption: 'One cell, outlined.',
    alt: 'Two cells in a field of view, one inside a dashed box',
    svg: `<rect x="8" y="8" width="80" height="80" fill="#E4F2F8"/>
      <circle cx="40" cy="44" r="18" fill="#00A5A3" style="mix-blend-mode:multiply"/>
      <circle cx="68" cy="66" r="10" fill="#9A4061"/>
      <rect x="18" y="22" width="44" height="44" fill="none" stroke="#1C1E1F" stroke-width="1.2" stroke-dasharray="2 2"/>`,
  },
  'behavioural-setups': {
    caption: 'An arena, and one path through it.',
    alt: 'A square arena with a winding path ending at a circle',
    svg: `<rect x="10" y="14" width="76" height="68" fill="#A0CFE6"/>
      <circle cx="64" cy="36" r="10" fill="#9A4061"/>
      <path d="M20 72 C 30 40, 46 74, 54 46 S 60 40, 64 38" fill="none" stroke="#1C1E1F" stroke-width="1.6"/>
      <rect x="16" y="68" width="8" height="8" fill="#00A5A3"/>`,
  },
  'behaviour-classification': {
    caption: 'Behaviour, labelled along time.',
    alt: 'A band of coloured segments above a time axis',
    svg: `<rect x="4" y="28" width="28" height="24" fill="#A0CFE6"/>
      <rect x="32" y="28" width="16" height="24" fill="#00A5A3"/>
      <rect x="48" y="28" width="34" height="24" fill="#A0CFE6"/>
      <rect x="82" y="28" width="10" height="24" fill="#9A4061"/>
      <path d="M4 70 H92 M4 66 V74 M26 66 V74 M48 66 V74 M70 66 V74 M92 66 V74" fill="none" stroke="#1C1E1F" stroke-width="1.2"/>`,
  },
  'data-analysis': {
    caption: 'Points, and a line through them.',
    alt: 'Scattered points on two axes with a straight line through them',
    svg: `<path d="M10 8 V86 H90" fill="none" stroke="#1C1E1F" stroke-width="1.4"/>
      <circle cx="26" cy="68" r="5" fill="#00A5A3"/>
      <circle cx="40" cy="60" r="5" fill="#A0CFE6"/>
      <circle cx="52" cy="46" r="5" fill="#00A5A3"/>
      <circle cx="66" cy="42" r="5" fill="#A0CFE6"/>
      <circle cx="78" cy="26" r="5" fill="#00A5A3"/>
      <path d="M16 78 L88 20" fill="none" stroke="#9A4061" stroke-width="1.6"/>`,
  },
  visualisation: {
    caption: 'Three bars, one message.',
    alt: 'Three bars of different heights on a baseline',
    svg: `<rect x="14" y="50" width="18" height="36" fill="#A0CFE6"/>
      <rect x="38" y="26" width="18" height="60" fill="#00A5A3"/>
      <rect x="62" y="40" width="18" height="46" fill="#9A4061"/>
      <path d="M6 86 H90" fill="none" stroke="#1C1E1F" stroke-width="1.4"/>`,
  },
  hardware: {
    caption: 'A board, a light.',
    alt: 'A square chip with pins and a small round light at its corner',
    svg: `<rect x="20" y="24" width="50" height="50" fill="#A0CFE6"/>
      <path d="M28 16 V24 M40 16 V24 M52 16 V24 M64 16 V24 M28 74 V82 M40 74 V82 M52 74 V82 M64 74 V82 M4 49 H20 M70 49 H92" fill="none" stroke="#1C1E1F" stroke-width="1.4"/>
      <circle cx="72" cy="28" r="10" fill="#9A4061"/>`,
  },
};
const fig = FIGS[topic] ?? FIGS.synchronization;
---

<figure class:list={['fig', className]}>
  <svg viewBox="0 0 96 96" role="img" aria-label={`Illustration: ${fig.alt}`} set:html={fig.svg} />
  <figcaption>Fig. — {fig.caption}</figcaption>
</figure>
