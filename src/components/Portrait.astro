---
import type { Person } from '../lib/people';
import { initials, tileFor } from '../lib/people';
import { href } from '../lib/paths';

interface Props {
  person: Person;
  size?: 'lg' | 'md' | 'sm';
}
const { person, size = 'sm' } = Astro.props;
const tile = tileFor(person.id);
const letters = initials(person.data.name);
const photo = person.data.photo;
---

{
  size === 'lg' ? (
    photo ? (
      <img class="portrait-lg" src={href(photo)} alt={`Portrait of ${person.data.name}`} width="240" height="300" />
    ) : (
      <div class="portrait-lg initials" style={`background:${tile.bg}`} aria-hidden="true">
        <svg viewBox="0 0 240 300" preserveAspectRatio="xMaxYMin slice">
          <circle cx="232" cy="12" r="104" fill={tile.circle} />
          <path d="M120 70 H170 V44 H200 V70 H240" fill="none" stroke={tile.bg} stroke-width="5" />
        </svg>
        <span>{letters}</span>
      </div>
    )
  ) : photo ? (
    <img class:list={['tile', size]} src={href(photo)} alt="" />
  ) : (
    <span class:list={['tile', size]} style={`background:${tile.bg}`} aria-hidden="true">
      {letters}
    </span>
  )
}

<style>
  .portrait-lg {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    border-radius: var(--r-tile);
  }
  .initials {
    position: relative;
    overflow: hidden;
    container-type: inline-size;
  }
  .initials svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .initials span {
    position: absolute;
    left: 8cqw;
    bottom: 6cqw;
    font-family: var(--serif);
    font-size: 32cqw;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .tile {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-tile);
    font-family: var(--serif);
    font-weight: 900;
    object-fit: cover;
  }
  .sm {
    width: 56px;
    height: 56px;
    font-size: 19px;
  }
  .md {
    width: 64px;
    height: 64px;
    font-size: 22px;
  }
</style>
